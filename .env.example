NODE_ENV=development
PORT=3014
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
DATABASE_URL=postgres://deposit_svc:<DB_PASSWORD_DEPOSIT>@localhost:5432/deposit_db
# El mismo JWT_SECRET de auth-service (valida los tokens de los clientes).
JWT_SECRET=
ACCOUNT_SERVICE_URL=http://localhost:3002
LEDGER_SERVICE_URL=http://localhost:3006
# Clave interna PROPIA de deposit-service (la acepta ledger-service como deposit:<clave>).
INTERNAL_API_KEY=
# Quién puede pedir el resumen para cancelar la cuenta (GET /internal/deposits/...): account-service.
INTERNAL_TRUSTED_KEYS=account:<clave-de-account>

# Pasarela Wompi. Las llaves están en el panel de Wompi (Desarrolladores > Llaves) y
# NUNCA se suben al repositorio. Con WOMPI_ENV=sandbox el servicio no arranca si
# alguna llave es de producción (pub_prod_, prv_prod_, prod_integrity_, prod_events_).
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Opcionales (estos son los valores por defecto).
# Monto mínimo y máximo de una recarga, en pesos.
DEPOSIT_MIN_AMOUNT=10000
DEPOSIT_MAX_AMOUNT=2000000
# Proceso de recargas pendientes (webhooks que no llegaron): cada cuánto corre, en ms.
PENDING_CHECK_INTERVAL_MS=300000
PENDING_CHECK_ENABLED=true
# Reintentos de las lecturas entre servicios (GET); las escrituras no se reintentan.
HTTP_READ_RETRIES=1

# Puerto de /metrics para Prometheus (solo red privada; no es el puerto público). "off" lo apaga.
METRICS_PORT=9100
